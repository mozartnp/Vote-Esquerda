# Cabeçalhos servidos pelo Cloudflare Pages.
# Sintaxe: um caminho na margem, cada cabeçalho indentado com 2 espaços.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'

# A página e a lista precisam revalidar: numa correção de véspera de eleição,
# o visitante tem que ver o texto novo no primeiro reload, não no segundo.
# Revalidar é barato — o ETag devolve 304 sem corpo.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/candidatos.json
  Cache-Control: public, max-age=0, must-revalidate

# Fotos não têm hash no nome (1350-pe.jpg), então cache eterno prenderia uma foto
# trocada por um ano. Um dia fresco, uma semana servindo o antigo enquanto rebusca.
/fotos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/logos/*
  Cache-Control: public, max-age=2592000

# Subconjuntos fixos: o conteúdo desses arquivos nunca muda.
/fontes/*
  Cache-Control: public, max-age=31536000, immutable
